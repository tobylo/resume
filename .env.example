# Copy this file to .env for local development (Vite only loads .env, not
# .env.example): cp .env.example .env
#
# Cloudflare Turnstile site key for the job fit analyzer.
# Optional for building: without it the site builds fine, but the analyzer's
# CAPTCHA never renders so submissions stay disabled. Set the real key in the
# Cloudflare Pages build environment (and here for local testing).
PUBLIC_TURNSTILE_SITE_KEY=
